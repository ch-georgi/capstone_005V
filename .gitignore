# =====================================================================
# .gitignore raÃ­z â€” cubre TODO el monorepo (apps/api, apps/web,
# apps/mobile, packages/, infrastructure/, etc.), no solo apps/api.
# =====================================================================

# Variables de entorno (credenciales reales) â€” nunca se suben.
# El .env.example de cada app sÃ­ se sube, sin valores reales.
.env
.env.local
.env.*.local
**/.env
!**/.env.example

# Dependencias de Node (se reinstalan con npm install, no se versionan)
node_modules/
**/node_modules/

# Builds compilados
dist/
build/
**/dist/
**/build/

# Logs
*.log
npm-debug.log*

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# ConfiguraciÃ³n local de VS Code que no debe compartirse
.vscode/*
!.vscode/extensions.json

# Configuración local de Claude Code (proyecto educativo: no se versiona)
.claude/

# Prisma: el cliente generado no se versiona (se regenera con prisma generate)
**/generated/prisma/

# Certificados o claves que pudieran agregarse mÃ¡s adelante
*.pem
*.key
*.crt
.cache/
__pycache__/
*.pyc

# Expo and generated native projects
**/.expo/
apps/mobile/android/
apps/mobile/ios/
**/coverage/
*.hprof
apps/mobile/artifacts/

# Evitar versionar configuraciones de producción con secretos.
.env.production
