{
  "expo": {
    "name": "WellQ",
    "slug": "wellq-mobile",
    "version": "0.3.2",
    "scheme": "wellq",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/wellq-logo.png",
    "splash": {
      "image": "./assets/wellq-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "android": {
      "package": "com.wellq.capstone",
      "adaptiveIcon": {
        "foregroundImage": "./assets/wellq-logo.png",
        "backgroundColor": "#000000"
      },
      "versionCode": 5
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/wellq-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "./plugins/with-wellq-icon.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
