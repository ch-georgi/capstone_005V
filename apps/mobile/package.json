    "apk:debug": "expo run:android --variant debug",
    "apk:preview": "node scripts/build-android.mjs",
    "apk": "node scripts/build-android.mjs --production",
    "apk:production": "node scripts/build-android.mjs --production",
    "check:production": "node scripts/build-android.mjs --production --check-config",
    "apk:demo": "node scripts/build-android.mjs --demo",
    "lint": "expo lint"
  },
  "private": true
