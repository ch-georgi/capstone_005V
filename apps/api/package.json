{
  "name": "wellq-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:fixtures": "ts-node scripts/upload-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "test:postgres": "ts-node scripts/test-postgres.ts",
    "test:sqlite": "python ../../database/tests/test_sqlite.py",
    "test:local": "node ../../database/tests/run-local.cjs",
    "db:check-invariants": "ts-node scripts/check-invariants.ts",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "start": "node dist/main.js",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test": "jest --runInBand",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "bootstrap:admin": "ts-node scripts/bootstrap-admin.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "prisma": "^5.20.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.2"
    }
  }
}
