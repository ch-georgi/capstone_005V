# Copiar este archivo como ".env" (sin .example) y no subirlo nunca a GitHub.

# Conexión a PostgreSQL local (la que levanta docker-compose.yml)
# DATABASE_URL="postgresql://wellq:wellq_dev_password@localhost:5432/wellq_dev?schema=public"

# Cuando el equipo cree el servicio en Railway, esta es la variable
# que se reemplaza allá (en la configuración de Railway, NO aquí en
# este archivo local) por la DATABASE_URL que Railway genera.

# Solo para db:fixtures: bucket existente, credenciales fuera del repositorio.
# S3_ENDPOINT=http://localhost:9222
# S3_BUCKET=wellq-dev
# S3_ACCESS_KEY_ID=wellq_minio
# S3_SECRET_ACCESS_KEY=wellq_minio_password
# S3_REGION=us-east-1
# TEST_DATABASE_URL debe apuntar a una BD descartable *_schema_test.

# Servidor HTTP. Generar JWT_SECRET aleatorio de al menos 32 bytes; sin valor predeterminado.
PORT=3000
# JWT_SECRET=
JWT_ISSUER=wellq-api
JWT_AUDIENCE=wellq-clients
# true/false; si se omite, habilitado en desarrollo y deshabilitado con NODE_ENV=production.
# SWAGGER_ENABLED=true

# Solo para npm run bootstrap:admin. No se ejecuta al iniciar la API.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
